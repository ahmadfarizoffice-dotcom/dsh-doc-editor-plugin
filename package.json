{
  "name": "dsh-doc-editor-plugin",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "ahmadfarizoffice-dotcom",
  "description": "Word-like document editor inside DeepSeek Harness with a LibreOffice-backed optional engine (52 MCP tools), 10vh draggable ribbon, theme-aware 22px icons, in-panel file chooser and Ctrl+O, DSH-aware shortcuts (Ctrl+I/U/Z/Y/S/F/O/K plus Ctrl+Shift+B because the host reserves Ctrl+B), multi-paragraph selection, hard line breaks and duplicate-free typing.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "documents",
    "docx",
    "pages",
    "pdf",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmadfarizoffice-dotcom/dsh-doc-editor-plugin.git"
  },
  "homepage": "https://github.com/ahmadfarizoffice-dotcom/dsh-doc-editor-plugin#readme",
  "bugs": {
    "url": "https://github.com/ahmadfarizoffice-dotcom/dsh-doc-editor-plugin/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "engine.js",
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
